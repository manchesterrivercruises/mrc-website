---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import CTASection from '../components/CTASection.astro';
import FAQSection from '../components/FAQSection.astro';
import GettingHere from '../components/GettingHere.astro';
import KeyFacts from '../components/KeyFacts.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCollection } from 'astro:content';
import copy from '../content/page-copy/party-boat-manchester.json';
import { sec, list, faqGroup, faqs as faqItems, str } from '../lib/pageCopy';

// EDITABLE COPY lives in the CMS (Page copy → party-boat-manchester) and is stored in
// src/content/page-copy/party-boat-manchester.json. This template owns STRUCTURE ONLY
// — layout, components, icons, every href (including the ?time=daytime What's On deep
// link), the schema block and the events-collection teaser query below.

// Occasion-led landing page. It does NOT re-list the full events catalogue (that's
// /music-cruises-manchester) — the only shared block is a small teaser grid below.
// Party-relevant events = live-music + DJ nights (drafts excluded).
const partyEvents = await getCollection(
  'events',
  ({ data }) => !data.draft && (data.category === 'dj-night' || data.category === 'live-music'),
);
// "Soonest-relevant": prefer events with a real startDate (soonest first); undated
// events fall back to a stable alphabetical order. No event carries a date yet (dates
// live in Ventrata), so today this surfaces a representative sample — it becomes a true
// soonest-first teaser automatically once dates are added.
const teaserEvents = partyEvents
  .sort((a, b) => {
    const da = a.data.startDate?.getTime();
    const db = b.data.startDate?.getTime();
    if (da != null && db != null) return da - db;
    if (da != null) return -1;
    if (db != null) return 1;
    return a.data.title.localeCompare(b.data.title);
  })
  .slice(0, 6);

const icons = {
  calendar:
    '<path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />',
  users:
    '<path d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />',
  sparkles:
    '<path d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" /><path d="M18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />',
  pin: '<path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />',
};

// Icons are structural; only the fact labels come from the CMS, zipped by position.
const factIcons = [icons.users, icons.calendar, icons.sparkles, icons.pin];
const keyFacts = (copy.keyFacts ?? []).map((text, i) => ({ text, icon: factIcons[i] ?? icons.pin }));

// Occasion-led content — the heart of this page, and the main thing that sets it apart
// from the music-cruises catalogue. The section IDs are anchors (structure); every word
// comes from the CMS entry, keyed off the same id.
const OCCASION_IDS = ['birthdays', 'hen-stag', 'work'];
const occasions = OCCASION_IDS.map((id) => ({
  id,
  title: sec(copy, id).heading,
  copy: sec(copy, id).body ?? [],
  highlights: list(copy, `${id}-highlights`),
}));

const faqs = faqItems(copy);

const SITE = site.url;
// Title/meta stay targeted on "party boat Manchester".
const pageTitle = copy.seoTitle!;
const pageDescription = copy.seoDescription!;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: 'Party Boat Manchester',
  description: pageDescription,
  url: `${SITE}/party-boat-manchester`,
  touristType: 'Nightlife',
  availableLanguage: 'English',
  address: { '@type': 'PostalAddress', ...site.address },
  geo: { '@type': 'GeoCoordinates', ...site.geo },
};
---

<BaseLayout title={pageTitle} description={pageDescription} image="/images/gallery/boat-tropicana/dj-and-the-dancefloor.webp">
  {/* Schema.org structured data (TouristAttraction) */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <div class="pb-24 md:pb-0">
    {/* Hero — dark navy, gold accents; occasion-led */}
    <section class="bg-dark text-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">{copy.eyebrow}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">{copy.heading}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80">
          {copy.intro}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <CTAButton href="/private-hire">{str(copy, 'heroCtaLabel')}</CTAButton>
          <a href="#party-nights" class="text-sm font-medium text-white/90 underline-offset-4 hover:underline">
            {str(copy, 'heroSecondaryLabel')}
          </a>
        </div>
      </div>
    </section>

    {/* Key facts strip */}
    <KeyFacts facts={keyFacts} />

    {/* Content (single column) */}
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-12 lg:px-8">
      <div class="space-y-12 md:space-y-14">
        {/* Occasion overview intro */}
        <section aria-labelledby="about">
          <SectionHeading id="about">{sec(copy, 'about').heading}</SectionHeading>
          <div class="mt-6 max-w-3xl space-y-4 text-lg leading-relaxed text-body">
            <p>
              {str(copy, 'aboutBefore')} <strong>{str(copy, 'aboutEmphasis1')}</strong> {str(copy, 'aboutMid')}{' '}
              <strong>{str(copy, 'aboutEmphasis2')}</strong> {str(copy, 'aboutAfter')}
            </p>
            <p>
              {str(copy, 'christmasNoteBefore')}{' '}
              <a href="/christmas-cruises-manchester" class="font-medium text-primary underline-offset-4 hover:underline">{str(copy, 'christmasNoteLinkText')}</a>{str(copy, 'christmasNoteAfter')}
            </p>
            <p class="text-base text-subtle">{str(copy, 'aboutTbc')}</p>
            <p class="text-base text-subtle">
              {str(copy, 'giftNoteBefore')}{' '}
              <a href="/gift-vouchers" class="font-medium text-primary underline-offset-4 hover:underline">
                {str(copy, 'giftNoteLinkText')}
              </a>{' '}
              {str(copy, 'giftNoteAfter')}
            </p>
          </div>
        </section>
      </div>
    </div>

    {/* Private hire — equal billing, high on the page (not a footer callout) */}
    <CTASection
      heading={str(copy, 'privateHireCtaHeading')}
      text={str(copy, 'privateHireCtaText')}
      primaryHref="/private-hire"
      primaryLabel={str(copy, 'privateHireCtaPrimaryLabel')}
      secondaryHref="#party-nights"
      secondaryLabel={str(copy, 'privateHireCtaSecondaryLabel')}
    />

    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-12 lg:px-8">
      <div class="space-y-12 md:space-y-16">
        {/* Occasion sections — the differentiator vs the music-cruises catalogue */}
        {
          occasions.map((o) => (
            <section aria-labelledby={o.id}>
              <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-start lg:gap-12">
                <div>
                  <SectionHeading id={o.id}>{o.title}</SectionHeading>
                  <div class="mt-6 space-y-4 text-lg leading-relaxed text-body">
                    {o.copy.map((p) => (
                      <p>{p}</p>
                    ))}
                  </div>
                </div>
                <div class="rounded-card bg-panel p-6 ring-1 ring-black/5">
                  <h3 class="text-sm font-semibold uppercase tracking-wider text-subtle">{str(copy, 'asideTitle')}</h3>
                  <ul class="mt-4 space-y-3">
                    {o.highlights.map((h) => (
                      <li class="flex gap-3 text-body">
                        <span aria-hidden="true" class="mt-0.5 flex-none text-primary">✓</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </section>
          ))
        }

        {/* Daytime parties — timing is an attribute, not just a night thing. Confirmed daytime
            programme (2026): Decks on Deck + daytime ABBA sailings, with Dolly joining in 2027.
            Deep-links to What's On pre-filtered to daytime (?time=daytime). */}
        <section id="daytime-parties" aria-labelledby="daytime-parties-heading">
          <SectionHeading id="daytime-parties-heading">{sec(copy, 'daytime').heading}</SectionHeading>
          <p class="mt-6 max-w-3xl text-body">
            {str(copy, 'daytimeBefore')} <strong class="font-semibold text-ink">{str(copy, 'daytimeEmphasis1')}</strong>
            {' '}{str(copy, 'daytimeMid1')}
            <strong class="font-semibold text-ink"> {str(copy, 'daytimeEmphasis2')}</strong> {str(copy, 'daytimeMid2')}
            <strong class="font-semibold text-ink"> {str(copy, 'daytimeEmphasis3')}</strong> {str(copy, 'daytimeAfter')}
          </p>
          <div class="mt-8">
            <CTAButton href="/whats-on?time=daytime">{str(copy, 'daytimeCtaLabel')}</CTAButton>
          </div>
        </section>

        {/* Teaser grid — the ONLY block shared with /music-cruises-manchester. A small
            sample of party nights; the full categorised catalogue lives on that page. */}
        <section id="party-nights" aria-labelledby="party-nights-heading">
          <SectionHeading id="party-nights-heading">{sec(copy, 'party-nights').heading}</SectionHeading>
          <p class="mt-6 max-w-3xl text-body">
            {sec(copy, 'party-nights').body?.[0]}
          </p>
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              teaserEvents.map((e) => (
                <ProductCard
                  name={e.data.title}
                  desc={e.data.shortTagline ?? e.data.description}
                  href={`/tour/${e.id}`}
                  linkText={str(copy, 'partyNightsLinkText')}
                  image={e.data.heroImage}
                  imageAlt={e.data.heroImageAlt}
                />
              ))
            }
          </div>
          <div class="mt-8">
            <CTAButton href="/music-cruises-manchester" variant="outline">{str(copy, 'partyNightsCtaLabel')}</CTAButton>
          </div>
        </section>

        <FAQSection faqs={faqs} title={faqGroup(copy, 'main').title} />

        <GettingHere />
      </div>
    </div>
  </div>

  {/* Mobile sticky CTA — lead with the differentiating action (private hire enquiry). */}
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-black/10 bg-white/95 p-3 backdrop-blur md:hidden">
    <CTAButton href="/private-hire" class="w-full">{str(copy, 'mobileCtaLabel')}</CTAButton>
  </div>
</BaseLayout>
