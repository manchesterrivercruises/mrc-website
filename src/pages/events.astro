---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import FAQSection from '../components/FAQSection.astro';
import GettingHere from '../components/GettingHere.astro';
import KeyFacts from '../components/KeyFacts.astro';
import ProductCard from '../components/ProductCard.astro';
import copy from '../content/page-copy/events.json';
import { sec, cards, faqGroup, faqs, str } from '../lib/pageCopy';

// EDITABLE COPY lives in the CMS (Page copy → events) and is stored in
// src/content/page-copy/events.json. This template owns STRUCTURE ONLY — layout, components,
// icons, every href, and the schema block. See docs/content-management.md.

const icons = {
  calendar:
    '<path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />',
  tag: '<path d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" /><path d="M6 6h.008v.008H6V6Z" />',
  sparkles:
    '<path d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" /><path d="M18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />',
  pin: '<path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />',
};

// Icons are structural; only the labels come from the CMS, zipped by position.
const factIcons = [icons.calendar, icons.tag, icons.sparkles, icons.pin];
const keyFacts = (copy.keyFacts ?? []).map((text, i) => ({ text, icon: factIcons[i] ?? icons.calendar }));

// Category DESTINATIONS stay in code — routes are structure, and an editor must not be able to
// point a card at a path that 404s. The wording comes from the CMS, matched on the card key.
const CATEGORY_HREFS: Record<string, string> = {
  'live-music': '/music-cruises-manchester',
  dj: '/whats-on',
  family: '/whats-on',
  christmas: '/christmas-cruises-manchester',
  santa: '/santa-cruise-manchester',
  seasonal: '/whats-on',
};
const categories = cards(copy, 'categories').map((c) => ({ ...c, href: CATEGORY_HREFS[c.key.split(':')[1]] }));
const steps = cards(copy, 'steps');
const faqItems = faqs(copy);

const SITE = site.url;
const pageTitle = copy.seoTitle!;
const pageDescription = copy.seoDescription!;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Events & Special Cruises',
  description: pageDescription,
  url: `${SITE}/events`,
  itemListElement: categories.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    url: `${SITE}${c.href}`,
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {/* Schema.org structured data (ItemList of event categories) */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <div>
    {/* Hero — dark navy, gold accents */}
    <section class="bg-dark text-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">{copy.eyebrow}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">{copy.heading}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80">{copy.intro}</p>
        <div class="mt-8">
          <CTAButton href="/whats-on">{str(copy, 'heroCtaLabel')}</CTAButton>
        </div>
      </div>
    </section>

    <KeyFacts facts={keyFacts} />

    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
      <div class="space-y-16">
        {/* Event categories */}
        <section aria-labelledby="categories">
          <SectionHeading id="categories">{sec(copy, 'categories').heading}</SectionHeading>
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {categories.map((c) => <ProductCard name={c.name} desc={c.desc} href={c.href} linkText={c.linkText} />)}
          </div>
        </section>

        {/* Upcoming events */}
        <section aria-labelledby="upcoming">
          <SectionHeading id="upcoming">{sec(copy, 'upcoming').heading}</SectionHeading>
          <div class="mt-6 max-w-3xl space-y-4 text-lg leading-relaxed text-body">
            <p>{sec(copy, 'upcoming').body?.[0]}</p>
          </div>
          <div class="mt-6">
            <CTAButton href="/whats-on">{str(copy, 'upcomingCtaLabel')}</CTAButton>
          </div>
        </section>

        {/* How events work */}
        <section aria-labelledby="how">
          <SectionHeading id="how">{sec(copy, 'how').heading}</SectionHeading>
          <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
            {
              steps.map((s, i) => (
                <div class="flex flex-col">
                  <span
                    aria-hidden="true"
                    class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-accent font-bold text-dark"
                  >
                    {i + 1}
                  </span>
                  <h3 class="mt-4 text-lg font-semibold text-ink">{s.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-body">{s.desc}</p>
                </div>
              ))
            }
          </div>
        </section>

        {/* Private events callout */}
        <section aria-labelledby="private">
          <div class="rounded-card bg-dark p-8 text-white sm:p-10">
            <h2 id="private" class="text-2xl font-bold tracking-tight sm:text-3xl">{sec(copy, 'private').heading}</h2>
            <p class="mt-3 max-w-2xl text-lg leading-relaxed text-white/80">{sec(copy, 'private').body?.[0]}</p>
            <div class="mt-6">
              <CTAButton href="/private-hire">{str(copy, 'privateCtaLabel')}</CTAButton>
            </div>
          </div>
        </section>

        <FAQSection faqs={faqItems} title={faqGroup(copy, 'main').title} />

        <GettingHere />
      </div>
    </div>
  </div>
</BaseLayout>
