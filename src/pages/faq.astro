---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import FAQSection from '../components/FAQSection.astro';
import CTAButton from '../components/CTAButton.astro';
import copy from '../content/page-copy/faq.json';
import { faqGroup, faqs, str } from '../lib/pageCopy';

// EDITABLE COPY lives in the CMS (Page copy → faq) and is stored in
// src/content/page-copy/faq.json. This template owns STRUCTURE ONLY — layout, components,
// icons, every href, the schema block and any live data. See docs/content-management.md.

// FAQ content is CMS-owned (Page copy → faq). The GROUP KEYS and their order are structure:
// they drive the section ids that /faq#booking-style deep links rely on, so they stay here.
const FAQ_GROUPS = [
  { key: 'general', id: 'general' },
  { key: 'cityRiverTour', id: 'city-river-tour' },
  { key: 'events', id: 'events' },
  { key: 'gettingHere', id: 'getting-here' },
  { key: 'booking', id: 'booking' },
  { key: 'accessibility', id: 'accessibility' },
].map((g) => ({ ...g, title: faqGroup(copy, g.key).title, items: faqs(copy, g.key) }));

const SITE = site.url;
const pageTitle = copy.seoTitle!;
const pageDescription = copy.seoDescription!;

// FAQPage schema built from every Q&A on the page.
const allFaqs = FAQ_GROUPS.flatMap((g) => g.items);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {/* Schema.org structured data (FAQPage) */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-20">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{copy.heading}</h1>
    <p class="mt-4 text-lg leading-relaxed text-body">{copy.intro}</p>

    <div class="mt-10 space-y-12">
      {FAQ_GROUPS.map((g) => <FAQSection faqs={g.items} title={g.title} id={g.id} />)}
    </div>

    <div class="mt-12 rounded-card bg-panel p-6 ring-1 ring-black/5 sm:flex sm:items-center sm:justify-between sm:gap-6">
      <p class="font-semibold text-ink">{str(copy, 'stillStuckPrompt')}</p>
      <div class="mt-4 shrink-0 sm:mt-0">
        <CTAButton href="/contact-us">{str(copy, 'stillStuckCtaLabel')}</CTAButton>
      </div>
    </div>
  </div>
</BaseLayout>
