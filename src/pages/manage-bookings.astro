---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import HowToKnowItsUs from '../components/HowToKnowItsUs.astro';
import { VENTRATA_MMB_URL } from '../data/ventrata';
import copy from '../content/page-copy/manage-bookings.json';
import { sec, list, cards, str } from '../lib/pageCopy';

// EDITABLE COPY lives in the CMS (Page copy → manage-bookings) and is stored in
// src/content/page-copy/manage-bookings.json. This template owns STRUCTURE ONLY — layout, components,
// icons, every href, the schema block and any live data. See docs/content-management.md.

const SITE = site.url;
const pageTitle = copy.seoTitle!;
const pageDescription = copy.seoDescription!;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Manage My Booking',
  description: pageDescription,
  url: `${SITE}/manage-bookings`,
};

// The self-service list and the "needs a call" cards are CMS-owned (Page copy → manage-bookings).
// Those capabilities were CONFIRMED by Ventrata support for the hosted Manage My Booking portal
// (checkin.ventrata.com) — if the portal's capabilities change, the wording here must follow.
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {/* Schema.org structured data (WebPage) */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 md:py-20">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{copy.heading}</h1>
    <p class="mt-4 text-lg leading-relaxed text-body">
      {str(copy, 'introBefore')}{' '}
      <strong class="font-semibold text-ink">{str(copy, 'introRefLabel')}</strong> {str(copy, 'introJoin')}
      <strong class="font-semibold text-ink">{str(copy, 'introEmailLabel')}</strong> {str(copy, 'introAfter')}
    </p>

    {/* PRIMARY CTA — a plain LINK to Ventrata's HOSTED Manage My Booking portal
        (checkin.ventrata.com/{checkoutKey}), opened in a new tab. Deliberately a link, NOT an embed
        or pop-up widget: the portal is Ventrata's own hosted app with its own booking-lookup, session
        and auth handling — linking hands that off cleanly (no iframe/session edge cases on our side)
        and always tracks whatever the portal supports. It's brand-styled via Ventrata Brands, so it
        looks and feels like ours — hence the "our secure booking portal" framing rather than a
        "you're leaving the site" warning. The earlier openReservationFlow trigger was a guessed key
        and is removed (marked wrong/legacy in docs/ventrata-integration.md). */}
    <div class="mt-8">
      <CTAButton href={VENTRATA_MMB_URL} class="w-full sm:w-auto" target="_blank" rel="noopener noreferrer">
        {str(copy, 'portalCtaLabel')}
      </CTAButton>
      <p class="mt-3 text-sm text-subtle">{str(copy, 'portalNote')}</p>
    </div>

    {/* What you can do here */}
    <div class="mt-12">
      <SectionHeading as="h2">{sec(copy, 'selfService').heading}</SectionHeading>
      <ul class="mt-4 space-y-3 text-body">
        {
          list(copy, 'selfService').map((item) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-primary" aria-hidden="true" />
              <span class="leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    {/* What needs a call */}
    <div class="mt-12">
      <SectionHeading as="h2">{sec(copy, 'needsACall').heading}</SectionHeading>
      <p class="mt-4 text-body">{sec(copy, 'needsACall').body?.[0]}</p>
      <dl class="mt-6 space-y-5">
        {
          cards(copy, 'needsACall').map((n) => (
            <div class="rounded-card bg-panel p-5 ring-1 ring-black/5">
              <dt class="font-semibold text-ink">{n.name}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-body">{n.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/* Contact fallback */}
    <div class="mt-12 rounded-card bg-panel p-6 ring-1 ring-black/5">
      <SectionHeading as="h2">{sec(copy, 'cantFind').heading}</SectionHeading>
      <p class="mt-4 text-body">{sec(copy, 'cantFind').body?.[0]}</p>
      <address class="mt-3 space-y-1 text-sm not-italic text-body">
        <p>
          <a href={`mailto:${site.email}`} class="font-medium text-primary hover:underline">
            {site.email}
          </a>
        </p>
        <p>
          <a href={site.phoneHref} class="font-medium text-primary hover:underline">
            {site.phone}
          </a>
        </p>
      </address>
      <div class="mt-5">
        <CTAButton href="/faq" variant="outline">{str(copy, 'faqCtaLabel')}</CTAButton>
      </div>
    </div>

    {/* Anti-phishing. This page sends people to checkin.ventrata.com — a domain that is not
        ours — and their tickets arrive from Ventrata rather than from an MRC address. Both are
        legitimate and both look exactly like what customers are warned to distrust, so say so
        plainly here rather than leaving them to guess. */}
    <HowToKnowItsUs class="mt-12" />
  </section>
</BaseLayout>
