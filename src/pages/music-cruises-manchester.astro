---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import FAQSection from '../components/FAQSection.astro';
import GettingHere from '../components/GettingHere.astro';
import KeyFacts from '../components/KeyFacts.astro';
import ProductCard from '../components/ProductCard.astro';
import { siteImages } from '../data/siteImages';
import { getCollection } from 'astro:content';
import copy from '../content/page-copy/music-cruises-manchester.json';
import { sec, card, faqGroup, faqs, str } from '../lib/pageCopy';

// EDITABLE COPY lives in the CMS (Page copy → music-cruises-manchester) and is stored in
// src/content/page-copy/music-cruises-manchester.json. STRUCTURE stays here — and so does the
// EVENT LIST below, which is live data from the events collection, not copy.

// Event lists pulled from the events collection (drafts excluded), split by category.
const events = await getCollection('events', ({ data }) => !data.draft);
const liveMusicNights = events
  .filter((e) => e.data.category === 'live-music')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const djNights = events
  .filter((e) => e.data.category === 'dj-night')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const icons = {
  calendar:
    '<path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />',
  tag: '<path d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" /><path d="M6 6h.008v.008H6V6Z" />',
  music:
    '<path d="M9 9l10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163V4.575a.75.75 0 0 0-.926-.729l-8.4 2.4a.75.75 0 0 0-.544.721v9.146a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 9 12.626V6.75" />',
  sparkles:
    '<path d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" /><path d="M18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />',
};

// Icons are structural; only the labels come from the CMS, zipped by position.
const factIcons = [icons.calendar, icons.tag, icons.music, icons.sparkles];
const keyFacts = (copy.keyFacts ?? []).map((text, i) => ({ text, icon: factIcons[i] ?? icons.calendar }));

const faqItems = faqs(copy);

const SITE = site.url;
const pageTitle = copy.seoTitle!;
const pageDescription = copy.seoDescription!;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: 'Music Cruises Manchester',
  description: pageDescription,
  url: `${SITE}/music-cruises-manchester`,
  touristType: 'Nightlife',
  availableLanguage: 'English',
  address: { '@type': 'PostalAddress', ...site.address },
  geo: { '@type': 'GeoCoordinates', ...site.geo },
};
---

<BaseLayout title={pageTitle} description={pageDescription} image="/images/gallery/soul-river/soul-singer-among-the-crowd.webp">
  {/* Schema.org structured data (TouristAttraction) */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <div class="pb-24 md:pb-0">
    {/* Hero — dark navy, gold accents */}
    <section class="bg-dark text-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">{copy.eyebrow}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">{copy.heading}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80">{copy.intro}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <CTAButton href="/whats-on">{str(copy, 'heroCtaLabel')}</CTAButton>
          <span class="text-sm text-white/70">{str(copy, 'heroPriceNote')}</span>
        </div>
      </div>
    </section>

    {/* Key facts strip */}
    <KeyFacts facts={keyFacts} />

    {/* Content (single column) */}
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-12 lg:px-8">
      <div class="space-y-12 md:space-y-14">
        <section aria-labelledby="about">
          <SectionHeading id="about">{sec(copy, 'about').heading}</SectionHeading>
          <div class="mt-6 max-w-3xl space-y-4 text-lg leading-relaxed text-body">
            <p>{sec(copy, 'about').body?.[0]}</p>
            <p>
              {str(copy, 'christmasNoteBefore')}{' '}
              <a href="/christmas-cruises-manchester" class="font-medium text-primary underline-offset-4 hover:underline">{str(copy, 'christmasNoteLinkText')}</a>{str(copy, 'christmasNoteAfter')}
            </p>
            <p class="text-base text-subtle">{sec(copy, 'about').note}</p>
          </div>
          <div class="mt-6">
            <CTAButton href="/whats-on">{str(copy, 'aboutCtaLabel')}</CTAButton>
          </div>
        </section>

        {/* Live Music Nights — from the events collection (category: live-music). */}
        <section aria-labelledby="live-music">
          <SectionHeading id="live-music">{sec(copy, 'liveMusic').heading}</SectionHeading>
          <p class="mt-6 max-w-3xl text-body">{sec(copy, 'liveMusic').body?.[0]}</p>
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              liveMusicNights.map((e) => (
                <ProductCard name={e.data.title} desc={e.data.shortTagline ?? e.data.description} href={`/tour/${e.id}`} linkText={str(copy, 'eventCardLinkText')} image={e.data.heroImage} imageAlt={e.data.heroImageAlt} />
              ))
            }
          </div>
        </section>

        {/* DJ Events — from the events collection (category: dj-night). Label says "Events" not
            "Nights" because some (e.g. Decks on Deck) sail daytime; the dj-night slug stays. */}
        <section aria-labelledby="dj-nights">
          <SectionHeading id="dj-nights">{sec(copy, 'djNights').heading}</SectionHeading>
          <p class="mt-6 max-w-3xl text-body">{sec(copy, 'djNights').body?.[0]}</p>
          <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              djNights.map((e) => (
                <ProductCard name={e.data.title} desc={e.data.shortTagline ?? e.data.description} href={`/tour/${e.id}`} linkText={str(copy, 'eventCardLinkText')} image={e.data.heroImage} imageAlt={e.data.heroImageAlt} />
              ))
            }
          </div>
          <p class="mt-6 text-sm text-subtle">{str(copy, 'allDatesBefore')} <a href="/whats-on" class="font-medium text-primary hover:underline">{str(copy, 'allDatesLinkText')}</a> {str(copy, 'allDatesAfter')}</p>
        </section>

        <FAQSection faqs={faqItems} title={faqGroup(copy, 'main').title} />

        {/* Cross-sell to City River Tour */}
        <section aria-labelledby="also">
          <SectionHeading id="also">{sec(copy, 'also').heading}</SectionHeading>
          <div class="mt-8 sm:max-w-sm">
            <ProductCard name={card(copy, 'crossSell:crt').name} desc={card(copy, 'crossSell:crt').desc} href="/tour/city-river-tours" image={siteImages.cityRiverTourCard.src} imageAlt={siteImages.cityRiverTourCard.alt} imageWidth={siteImages.cityRiverTourCard.width} imageHeight={siteImages.cityRiverTourCard.height} />
          </div>
        </section>

        <GettingHere />
      </div>
    </div>
  </div>

  {/* Mobile sticky CTA — link to the events listing (no product widget). */}
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-black/10 bg-white/95 p-3 backdrop-blur md:hidden">
    <CTAButton href="/whats-on" class="w-full">{str(copy, 'stickyCtaLabel')}</CTAButton>
  </div>
</BaseLayout>
