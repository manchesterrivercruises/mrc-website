---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import CTAButton from '../components/CTAButton.astro';

// Fleet — rendered from the `vessels` Content Collection, so Simon can edit every
// boat in the CMS (Content → Vessels) without touching this template.
//
// This page's own chrome (headings, labels, the CTA) stays in code deliberately —
// it is not in the Page copy collection. The VESSELS are the content here.
//
// Capacities and feature lists are genuinely unconfirmed, so entries leave those
// fields unset and the cards render an honest "TBC" rather than a made-up number.
// Only Isabella currently has a matched photo — the rest show the image placeholder,
// because a generic fleet shot on a named vessel would mislabel the boat.
const vessels = (await getCollection('vessels')).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999) || a.data.name.localeCompare(b.data.name),
);

const SITE = site.url;
const pageTitle = 'Our Fleet — Manchester River Cruises';
const pageDescription =
  'The Manchester River Cruises fleet — Princess Katherine, Isabella, Melody, Georgina and Joyce Too. Passenger capacities and details for sightseeing, events and private hire.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Our Fleet',
  description: pageDescription,
  url: `${SITE}/our-vessels`,
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {/* Schema.org structured data (WebPage) */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Our Fleet</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-body">
      Meet the boats that carry you along the Manchester Ship Canal. Full vessel details, capacities
      and photos are coming soon.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        vessels.map((v) => (
          <article class="overflow-hidden rounded-card bg-panel shadow-sm ring-1 ring-black/5">
            {
              v.data.heroImage ? (
                <img
                  src={v.data.heroImage}
                  alt={v.data.heroImageAlt ?? v.data.name}
                  width="800"
                  height="450"
                  loading="lazy"
                  decoding="async"
                  data-img-fallback
                  class="aspect-[16/9] w-full object-cover"
                />
              ) : (
                <div class="flex aspect-[16/9] items-center justify-center bg-black/5 text-sm text-subtle">Image (TBC)</div>
              )
            }
            <div class="p-5">
              <h2 class="text-lg font-semibold text-ink">{v.data.name}</h2>
              <dl class="mt-3 space-y-2 text-sm">
                <div class="flex gap-2">
                  <dt class="w-24 flex-none font-medium text-subtle">Capacity</dt>
                  <dd class="text-body">{v.data.capacity ?? 'TBC'}</dd>
                </div>
                <div class="flex gap-2">
                  <dt class="w-24 flex-none font-medium text-subtle">Best for</dt>
                  <dd class="text-body">{v.data.bestFor ?? 'TBC'}</dd>
                </div>
              </dl>
              {
                v.data.features?.length ? (
                  <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-body">
                    {v.data.features.map((f) => <li>{f}</li>)}
                  </ul>
                ) : (
                  <p class="mt-3 text-sm text-subtle">On-board features — TBC.</p>
                )
              }
              <p class="mt-3 text-sm text-subtle">{v.data.description}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-16 rounded-card bg-panel p-6 ring-1 ring-black/5 sm:flex sm:items-center sm:justify-between sm:gap-6">
      <p class="font-semibold text-ink">Ready to get on the water?</p>
      <div class="mt-4 shrink-0 sm:mt-0">
        <CTAButton href="/tour/city-river-tours">Book a cruise</CTAButton>
      </div>
    </div>
  </div>
</BaseLayout>
