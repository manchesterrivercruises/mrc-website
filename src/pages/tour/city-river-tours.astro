---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import SectionHeading from '../../components/SectionHeading.astro';
import BookingPanel from '../../components/BookingPanel.astro';
import VentrataWidget from '../../components/VentrataWidget.astro';
import ProductCard from '../../components/ProductCard.astro';
import AttractionCard from '../../components/AttractionCard.astro';
import { siteImages } from '../../data/siteImages';
import FAQSection from '../../components/FAQSection.astro';
import ReviewStrip from '../../components/ReviewStrip.astro';
import GettingHere from '../../components/GettingHere.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import MapTapActivate from '../../components/MapTapActivate.astro';
import tourStops from '../../data/tour-stops.json';
import copy from '../../content/page-copy/city-river-tours.json';
import { sec, list, cards, faqs as faqItems, str } from '../../lib/pageCopy';

// EDITABLE COPY lives in the CMS (Page copy → city-river-tours) and is stored in
// src/content/page-copy/city-river-tours.json. This template owns STRUCTURE ONLY —
// layout, components, icons, every href, the schema block, the Ventrata widgets and
// their product IDs, and the route/sights data (src/data/tour-stops.json + the map).
//
// Route POIs — src/data/tour-stops.json. Provenance: the 12 highlight stops (ids
// 1, 3, 4, 8, 11, 14, 18, 23, 25, 33, 37, 43) are the original website set. The
// remaining ids complete the GPS commentary app's 1–43 numbering, with coordinates
// interpolated along the waterway between those anchors. The tour-app repo
// (C:\Users\simon\mrc-tour-app) is the intended single source of truth across
// projects; replace tour-stops.json with an export from that project when available.
//
// NOTE: Items marked (TBC) await Simon's confirmed copy (content-checklist.md).

const icons = {
  clock: '<path d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />',
  tag: '<path d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" /><path d="M6 6h.008v.008H6V6Z" />',
  pin: '<path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />',
  calendar:
    '<path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />',
  tram: '<path d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.66-.837H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />',
  parking:
    '<path d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689C2.88 6.063 3 6.9 3 7.736v10.048c0 .836.88 1.38 1.628 1.006L9.5 16.356c.317-.159.69-.159 1.006 0l3.869 1.934c.317.159.69.159 1.006 0Z" />',
  sparkles:
    '<path d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" /><path d="M18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" />',
  accessibility:
    '<path d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />',
  phone:
    '<path d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5A2.25 2.25 0 0 0 8.25 22.5h7.5A2.25 2.25 0 0 0 18 20.25V3.75A2.25 2.25 0 0 0 15.75 1.5h-2.25m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />',
  shield: '<path d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.249-8.25-3.285Z" />',
  check: '<path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />',
};

// heroicons solid star path (title rating)
const STAR =
  'M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.563.563 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z';

// Icons are structural; only the fact labels come from the CMS, zipped by position.
// Order matches the brief At-a-Glance set: duration, price, departure, boarding,
// tram, parking, facilities, accessibility, mobile ticket, cancellation.
const factIcons = [
  icons.clock,
  icons.tag,
  icons.pin,
  icons.calendar,
  icons.tram,
  icons.parking,
  icons.sparkles,
  icons.accessibility,
  icons.phone,
  icons.shield,
];
const keyFacts = (copy.keyFacts ?? []).map((text, i) => ({ text, icon: factIcons[i] ?? icons.check }));

const included = list(copy, 'included');

// Card destinations stay in code, keyed off the card key the CMS holds — the wording
// is editable, the route is not.
//
// "Make a day of it" is still a hardcoded set of destinations. Migrating it to the
// `attractions` collection is a live decision (see docs/second-tour.md) — do not treat
// this map as permanent.
const DAY_OUT_HREFS: Record<string, string> = {
  'dayOut:iwm': '/discover/visiting-iwm-north',
  'dayOut:lowry': 'https://thelowry.com',
  'dayOut:corrie': '/discover/coronation-street-tour-manchester',
  'dayOut:oldTrafford': 'https://www.manutd.com/en/visit-old-trafford',
  'dayOut:nells': 'https://nellspizza.co.uk',
  'dayOut:ordsall': 'https://www.ordsallhall.com',
};

// MRC cross-sell ("You might also enjoy") — TEMPORARY static items.
// TODO (step 9): replace with live Ventrata product data.
const CROSS_SELL_HREFS: Record<string, string> = {
  'crossSell:santa': '/santa-cruise-manchester',
  'crossSell:abba': '/tour/mamma-mia-cruise-abba-tribute',
  'crossSell:ferry': '/tour/boat-to-old-trafford',
};
const CROSS_SELL_IMAGES = {
  'crossSell:santa': siteImages.santaCruiseCard,
  'crossSell:abba': siteImages.abbaCruiseCard,
  'crossSell:ferry': siteImages.ferryCard,
} as const;

// "Make a day of it" art. Only attractions we have our OWN photograph of are filled — IWM
// North, Old Trafford and the Coronation Street set are all shot from the ship canal on the
// tour itself; The Lowry is shot from the quayside plaza. Nell's Pizza and Ordsall Hall are
// third-party venues we hold no photography of, so they keep the placeholder tile
// (docs/photo-inventory.md → Shot list).
const DAY_OUT_IMAGES: Partial<Record<string, typeof siteImages.iwmNorth>> = {
  'dayOut:iwm': siteImages.iwmNorth,
  'dayOut:lowry': siteImages.theLowry,
  'dayOut:corrie': siteImages.coronationStreet,
  'dayOut:oldTrafford': siteImages.oldTrafford,
};

const faqs = faqItems(copy);

const pageTitle = copy.seoTitle!;
const pageDescription = copy.seoDescription!;

// Schema.org structured data (JSON-LD). Rendered from the page (BaseLayout owns <head>;
// JSON-LD is valid in <body> too). validFrom uses the build date.
const today = new Date().toISOString().slice(0, 10);
const SITE = site.url;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['TouristAttraction', 'Product'],
      name: 'City River Tour — Manchester Ship Canal',
      description:
        'Sightseeing cruise on the Manchester Ship Canal and River Irwell departing from Millennium Footbridge, Salford Quays. 60-minute round trip with audio commentary past IWM North, MediaCity, Old Trafford and more.',
      url: `${SITE}/tour/city-river-tours`,
      touristType: 'Sightseeing',
      availableLanguage: 'English',
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: site.rating.value,
        reviewCount: site.rating.count,
        bestRating: 5,
      },
      address: { '@type': 'PostalAddress', ...site.address },
      geo: { '@type': 'GeoCoordinates', ...site.geo },
      offers: {
        '@type': 'Offer',
        price: 13,
        priceCurrency: 'GBP',
        url: `${SITE}/tour/city-river-tours`,
        availability: 'https://schema.org/InStock',
        validFrom: today,
      },
      provider: { '@id': `${SITE}#business` },
    },
  ],
};

// What you'll see along the route, in order — rendered as a real <ol> beside the map so the itinerary is
// crawlable static content and available without JavaScript. The Leaflet map reads the same source
// (tour-stops.json). Highlights are the original 12 website stops; the collapsed list groups them first.
const orderedStops = [...tourStops].sort((a, b) => a.id - b.id);
const highlightStops = orderedStops.filter((s) => s.highlight);
const otherStops = orderedStops.filter((s) => !s.highlight);
const listStops = [...highlightStops, ...otherStops];
// The /tour/ namespace crumb resolves to the Events hub, which is wrong for CRT — it is the
// flagship sightseeing product, not an event. Explicit trail keeps the IA honest now that the
// URL sits under /tour/ (a URL decision, not a hierarchy change).
const crumbs = [
  { name: 'Home', url: `${SITE}/` },
  { name: 'City River Tour', url: `${SITE}/tour/city-river-tours` },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  bookProductID="ef45d8bd-529c-4dae-9c35-cd1b8e4e0a75"
  breadcrumbs={crumbs}
  image="/images/city-river-tour-hero.webp"
>
  {/* Ventrata checkout loader now ships site-wide via <Header> (AGENTS rule 9). */}

  {/* LCP preload — discovers the hero tile in <head>, before the body parser reaches the
      <img>, so it isn't queued behind the deferred checkout module. imagesrcset/imagesizes
      MIRROR the <img> exactly so the browser preloads the SAME candidate it will paint (an
      href-only preload would fetch the 1600px hero and waste the mobile srcset saving). */}
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/images/city-river-tour-hero.webp"
    imagesrcset="/images/city-river-tour-card.webp 800w, /images/city-river-tour-hero.webp 1600w"
    imagesizes="(min-width: 640px) 60vw, calc(100vw - 2rem)"
    fetchpriority="high"
  />

  {/* Schema.org structured data (JSON-LD) */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <!-- Leaflet (CDN — loaded only on this page). CSS must load before the JS below. -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style is:global>
    /* Explicit pixel height in CSS (Leaflet needs a real height, not only Tailwind). */
    #route-map {
      height: 300px;
      /* Own stacking context at z-0 so Leaflet's internal z-indexes (panes/controls
         up to ~1000) stay contained below the sticky header (z-50). */
      position: relative;
      z-index: 0;
    }
    @media (min-width: 768px) {
      #route-map {
        height: 450px;
      }
    }
  </style>
  <style>
    /* Cross-sell rotator: stack the items and fade through them (5s each, 15s loop). */
    .cross-sell {
      display: grid;
    }
    .cross-sell-item {
      grid-area: 1 / 1;
      opacity: 0;
      /* visibility:hidden (not just opacity:0) so an inactive slide's link is removed
         from the tab order — invisible links must not be keyboard-focusable. The base
         hidden state also covers each item's animation-delay window before it starts. */
      visibility: hidden;
      animation: crossSellFade 15s infinite;
    }
    @keyframes crossSellFade {
      0% { opacity: 0; visibility: visible; }
      2% { opacity: 1; visibility: visible; }
      31% { opacity: 1; visibility: visible; }
      33% { opacity: 0; visibility: hidden; }
      100% { opacity: 0; visibility: hidden; }
    }
    /* Pause the rotation while the reader hovers or keyboard-focuses within it. */
    .cross-sell:hover .cross-sell-item,
    .cross-sell:focus-within .cross-sell-item {
      animation-play-state: paused;
    }
    @media (prefers-reduced-motion: reduce) {
      .cross-sell-item { animation: none; opacity: 0; visibility: hidden; }
      .cross-sell-item:first-child { opacity: 1; visibility: visible; }
    }
  </style>

  <div class="pb-24 md:pb-0">
    {/* 1. Photo gallery mosaic — full width, before the title */}
    <section aria-label="Photo gallery" class="mx-auto max-w-6xl px-4 pt-6 sm:px-6 lg:px-8">
      {/* Owned photography — the hero shot plus two from the City River Tour gallery album
          (alt carried from the gallery data). */}
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-5 sm:items-start">
        {/* LCP element (mobile): first, largest tile. eager + fetchpriority="high" so the
            browser fetches it before the deferred checkout module and other images; a
            matching preload sits in <head> (slot="head" below). srcset lets mobile take the
            800px card variant (displayed ~380px CSS ≈ 760px @2×) instead of the 1600px hero,
            which is only needed for the ~680px-wide desktop tile at 2×. sizes: 60vw at sm+
            (3 of 5 grid cols), full-width-minus-padding below. */}
        <img
          src="/images/city-river-tour-hero.webp"
          srcset="/images/city-river-tour-card.webp 800w, /images/city-river-tour-hero.webp 1600w"
          sizes="(min-width: 640px) 60vw, calc(100vw - 2rem)"
          alt="The City River Tour boat passing beneath the Millennium Footbridge on a sunny day, with passengers on the open top deck and Old Trafford in the distance."
          width="1600"
          height="1200"
          loading="eager"
          fetchpriority="high"
          data-img-fallback
          class="aspect-[4/3] w-full rounded-card object-cover ring-1 ring-black/5 sm:col-span-3"
        />
        <div class="flex flex-col gap-2 sm:col-span-2">
          <img
            src="/images/gallery/city-river-tour/sightseeing-boat-arched-footbridge-aerial.webp"
            alt="Aerial view of a Manchester River Cruises sightseeing boat cruising the Manchester Ship Canal toward a steel arched footbridge, with the Deansgate Square towers on the skyline under a blue sky"
            width="1600"
            height="1200"
            loading="lazy"
            data-img-fallback
            class="aspect-[16/9] w-full rounded-card object-cover ring-1 ring-black/5"
          />
          <img
            src="/images/gallery/city-river-tour/open-top-deck-passengers-mediacity.webp"
            alt="Passengers on the open top deck of a City River Tour boat taking photos as it passes MediaCityUK and the Imperial Point tower at Salford Quays on a sunny day"
            width="1600"
            height="1066"
            loading="lazy"
            data-img-fallback
            class="aspect-[16/9] w-full rounded-card object-cover ring-1 ring-black/5"
          />
        </div>
      </div>
    </section>

    {/* 2. Title + rating */}
    <section class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl md:text-5xl">
        {copy.heading}
      </h1>
      {/* Score and review count are DERIVED from site.ts (the single source that also
          feeds aggregateRating below), so the visible rating can never drift from the
          structured one. Only the words around them are CMS copy. */}
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        <div class="flex items-center gap-2">
          <span class="sr-only">{str(copy, 'ratingSrBefore')} {site.rating.value} {str(copy, 'ratingSrAfter')}</span>
          <div class="flex items-center text-amber-400" aria-hidden="true">
            {[0, 1, 2, 3].map(() => (
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d={STAR} /></svg>
            ))}
            <svg class="h-5 w-5" viewBox="0 0 24 24">
              <defs>
                <linearGradient id="halfStarTop">
                  <stop offset="50%" stop-color="currentColor" />
                  <stop offset="50%" stop-color="rgb(0 0 0 / 0.12)" />
                </linearGradient>
              </defs>
              <path fill="url(#halfStarTop)" d={STAR} />
            </svg>
          </div>
          <span class="text-sm font-semibold text-ink">{site.rating.value}</span>
        </div>
        <a href="#reviews" class="text-sm font-medium text-primary hover:underline">{site.rating.count} {str(copy, 'reviewsLinkLabel')}</a>
        <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">{str(copy, 'topRatedBadge')}</span>
      </div>
    </section>

    {/* Key facts strip (with 24-hour cancellation badge via the slot) */}
    <KeyFacts facts={keyFacts}>
      <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-semibold text-primary sm:ml-2">
        <svg
          class="h-3.5 w-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={icons.clock}
        />
        {str(copy, 'cancellationBadge')}
      </span>
    </KeyFacts>

    {/* Interactive route map — between the gallery and the booking section */}
    <section aria-labelledby="route-map-heading" class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 lg:px-8">
      <SectionHeading id="route-map-heading">{sec(copy, 'routeMap').heading}</SectionHeading>
      <p class="mt-4 max-w-3xl text-body">{sec(copy, 'routeMap').body?.[0]}</p>
      <p class="mt-4 max-w-3xl text-body">{sec(copy, 'routeMap').body?.[1]}</p>
      <div
        id="route-map"
        class="mt-6 w-full overflow-hidden rounded-card ring-1 ring-black/5"
        aria-label="Interactive map of the City River Tour route along the Manchester Ship Canal"
      ></div>
      <noscript>
        <p class="mt-2 text-sm text-subtle">
          {str(copy, 'mapNoscript')}
        </p>
      </noscript>

      {/* Full route stops — the crawlable, screen-reader-accessible equivalent of the map.
          Collapsed by default in a native <details> (styled like the FAQ accordions). The
          list stays in the HTML whether open or closed — no duplicate bulky card grid. */}
      <div class="mt-8 max-w-3xl overflow-hidden rounded-card ring-1 ring-black/5">
        <details class="group bg-panel">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-medium text-ink">
            {str(copy, 'routeStopsSummaryBefore')} {orderedStops.length} {str(copy, 'routeStopsSummaryAfter')}
            <span
              aria-hidden="true"
              class="flex-none text-xl text-primary transition-transform group-open:rotate-45"
            >
              +
            </span>
          </summary>
          <ol class="list-none space-y-1.5 border-t border-black/10 px-5 py-4">
            {
              listStops.map((s) => (
                <li class="flex items-baseline gap-2">
                  <span aria-hidden="true" class="flex-none">{s.emoji}</span>
                  <span class="flex-none font-semibold text-ink">{s.name}</span>
                  {s.highlight && (
                    <span class="flex-none rounded-full bg-primary/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-primary">Highlight</span>
                  )}
                  <span class="min-w-0 flex-1 truncate text-sm text-subtle">{s.description}</span>
                </li>
              ))
            }
          </ol>
        </details>
      </div>
    </section>

    {/* 4. Two-column: main content (left 58%) + sticky booking panel (right 38%, 4% gap).
        Booking panel is DOM-first so on mobile it sits above the content (full width, not sticky). */}
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 md:py-12 lg:grid lg:grid-cols-[58%_38%] lg:items-start lg:gap-[4%] lg:px-8">
      {/* Right column — booking panel + cross-sell */}
      <aside id="book" class="mb-10 lg:order-2 lg:mb-0 lg:sticky lg:top-20">
        <BookingPanel price={str(copy, 'bookingPrice')} priceNote={str(copy, 'bookingPriceNote')}>
          {/* Ventrata embedded checkout widget (desktop) — City River Tour product. */}
          <VentrataWidget mode="embedded" productID="ef45d8bd-529c-4dae-9c35-cd1b8e4e0a75" slot="widget" />
        </BookingPanel>

        {/* MRC cross-sell — hidden on mobile. TODO (step 9): replace with live Ventrata product data. */}
        <div class="mt-6 hidden rounded-card bg-white p-5 shadow-sm ring-1 ring-black/5 lg:block">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-subtle">{str(copy, 'crossSellHeading')}</h2>
          <div class="cross-sell mt-4">
            {
              cards(copy, 'crossSell').map((p, i) => (
                <ProductCard
                  name={p.name}
                  desc={p.desc}
                  href={CROSS_SELL_HREFS[p.key]}
                  image={CROSS_SELL_IMAGES[p.key as keyof typeof CROSS_SELL_IMAGES]?.src}
                  imageAlt={CROSS_SELL_IMAGES[p.key as keyof typeof CROSS_SELL_IMAGES]?.alt}
                  imageWidth={CROSS_SELL_IMAGES[p.key as keyof typeof CROSS_SELL_IMAGES]?.width}
                  imageHeight={CROSS_SELL_IMAGES[p.key as keyof typeof CROSS_SELL_IMAGES]?.height}
                  class="cross-sell-item"
                  style={`animation-delay:${i * 5}s`}
                />
              ))
            }
          </div>
        </div>
      </aside>

      {/* Left column — main content */}
      <div class="space-y-12 md:space-y-14 lg:order-1">
        {/* Full description */}
        <section aria-labelledby="overview">
          <SectionHeading id="overview">{sec(copy, 'overview').heading}</SectionHeading>
          <div class="mt-6 max-w-3xl space-y-4 text-lg leading-relaxed text-body">
            <p>{sec(copy, 'overview').body?.[0]}</p>
            <p class="text-base text-subtle">{sec(copy, 'overview').note}</p>
          </div>
        </section>

        {/* What's included */}
        <section aria-labelledby="included">
          <SectionHeading id="included">{sec(copy, 'included').heading}</SectionHeading>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {
              included.map((item) => (
                <li class="flex items-start gap-2 text-body">
                  <svg
                    class="mt-0.5 h-5 w-5 flex-none text-primary"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={icons.check}
                  />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-3 text-sm text-subtle">{sec(copy, 'included').note}</p>
        </section>

        {/* Route itinerary */}
        <section aria-labelledby="route">
          <SectionHeading id="route">{sec(copy, 'route').heading}</SectionHeading>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-body">
            {sec(copy, 'route').body?.[0]}
          </p>
          <p class="mt-4 text-subtle">
            {sec(copy, 'route').note}
          </p>
        </section>

        {/* Getting Here (shared component — fixed template for bookable product pages) */}
        <GettingHere />

        {/* FAQ */}
        <FAQSection faqs={faqs} />

        {/* Groups & schools pointer — group rates and school/coach charters live on /groups */}
        <p class="max-w-3xl text-body">
          {str(copy, 'groupsPointerBefore')}{' '}
          <a href="/groups" class="font-medium text-primary underline-offset-4 hover:underline">
            {str(copy, 'groupsPointerLinkText')}
          </a>{' '}
          {str(copy, 'groupsPointerAfter')}
        </p>

        {/* Reviews — static aggregate for SEO; live Google reviews rotate in as an
            enhancement (silent fallback to the static line on any failure). */}
        <ReviewStrip rating={site.rating.value} reviewCount={site.rating.count} live />
      </div>
    </div>

    {/* Make a day of it — full-width grey band below the two-column block.
        TEMPORARY hardcoded list; to migrate to Astro Content Collections in a future CMS pass. */}
    <section aria-labelledby="day-out" class="bg-panel">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
        <SectionHeading id="day-out">{sec(copy, 'dayOut').heading}</SectionHeading>
        <p class="mt-4 max-w-2xl text-body">{sec(copy, 'dayOut').body?.[0]}</p>
        <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
{
            cards(copy, 'dayOut').map((item) => (
              <AttractionCard
                name={item.name}
                desc={item.desc}
                href={DAY_OUT_HREFS[item.key]}
                image={DAY_OUT_IMAGES[item.key]?.src}
                imageAlt={DAY_OUT_IMAGES[item.key]?.alt}
                imageWidth={DAY_OUT_IMAGES[item.key]?.width}
                imageHeight={DAY_OUT_IMAGES[item.key]?.height}
              />
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {/* Mobile sticky Book Now — Ventrata pop-up checkout (City River Tour product) */}
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-black/10 bg-white/95 p-3 backdrop-blur md:hidden">
    <VentrataWidget mode="popup" productID="ef45d8bd-529c-4dae-9c35-cd1b8e4e0a75" label="Book Now" class="w-full" />
  </div>

  {/* Leaflet — CSS is loaded above (before this JS). Markers only, no route line. */}
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  {/* Shared tap-to-activate helper (mobile scroll-trap fix) — defines window.mrcInitTapMap. */}
  <MapTapActivate />
  <script is:inline define:vars={{ stops: tourStops }}>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof L === 'undefined') return;
      var el = document.getElementById('route-map');
      if (!el || !stops.length) return;

      // Stops in route order (by id), numbered 1..N.
      var ordered = stops.slice().sort(function (a, b) { return a.id - b.id; });

      var map = L.map(el, { scrollWheelZoom: false });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors',
      }).addTo(map);

      // Highlights (the original 12) keep the emoji pin; the other 31 are smaller numbered dots.
      var latlngs = [];
      ordered.forEach(function (s) {
        latlngs.push([s.lat, s.lng]);
        var isHi = s.highlight === true;
        var icon = L.divIcon({
          className: isHi ? 'route-marker route-marker--highlight' : 'route-marker route-marker--stop',
          iconSize: isHi ? [32, 32] : [20, 20],
          iconAnchor: isHi ? [16, 16] : [10, 10],
          popupAnchor: isHi ? [0, -16] : [0, -10],
          html: isHi
            ? '<div style="width:32px;height:32px;display:flex;align-items:center;justify-center;border-radius:9999px;background:#fff;font-size:16px;line-height:1;box-shadow:0 1px 4px rgba(0,0,0,.3);">' + s.emoji + '</div>'
            : '<div style="width:20px;height:20px;display:flex;align-items:center;justify-center;border-radius:9999px;background:#0b1f3a;color:#fff;font-size:10px;font-weight:700;line-height:1;box-shadow:0 1px 3px rgba(0,0,0,.3);">' + s.id + '</div>',
        });
        // Build the popup as real DOM nodes with textContent (never string
        // concatenation) so stop data can never be interpreted as markup.
        var popup = document.createElement('div');
        popup.style.font = '13px/1.4 sans-serif';
        popup.style.color = '#1a1a1a';
        var title = document.createElement('strong');
        title.textContent = s.emoji + ' ' + s.name;
        var desc = document.createElement('p');
        desc.style.margin = '4px 0 0';
        desc.textContent = s.description;
        popup.appendChild(title);
        popup.appendChild(desc);
        L.marker([s.lat, s.lng], { icon: icon }).addTo(map).bindPopup(popup);
      });

      map.fitBounds(latlngs, { padding: [40, 40] });

      // Mobile scroll-trap fix: on touch devices the map starts inert behind a tap-to-explore
      // button so page swipes scroll past it (desktop pointer behaviour unchanged).
      if (window.mrcInitTapMap) window.mrcInitTapMap(el, map);
    });
  </script>
</BaseLayout>
