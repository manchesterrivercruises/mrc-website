---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import copy from '../content/page-copy/plan-your-visit.json';
import { sec, cards } from '../lib/pageCopy';

// EDITABLE COPY lives in the CMS (Page copy → plan-your-visit) and is stored in
// src/content/page-copy/plan-your-visit.json. This template owns STRUCTURE ONLY — layout, components,
// icons, every href, the schema block and any live data. See docs/content-management.md.

const SITE = site.url;
const pageTitle = copy.seoTitle!;
const pageDescription = copy.seoDescription!;

// Destinations stay in code (routes are structure); the card wording comes from the CMS,
// matched by the part of the key after "links:".
const LINK_HREFS: Record<string, string> = {
  'getting-here': '/getting-here',
  accessibility: '/accessibility',
  faq: '/faq',
  'gift-vouchers': '/gift-vouchers',
  'whats-on': '/whats-on',
  gallery: '/gallery',
  groups: '/groups',
};
const links = cards(copy, 'links').map((c) => ({ ...c, href: LINK_HREFS[c.key.split(':')[1]] }));

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Plan Your Visit',
  description: pageDescription,
  url: `${SITE}/plan-your-visit`,
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {/* Schema.org structured data (WebPage) */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{copy.heading}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-body">
      {copy.intro}
    </p>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {links.map((l) => <ProductCard name={l.name} desc={l.desc} href={l.href} linkText={l.linkText} />)}
    </div>

    {/* What to bring */}
    <section aria-labelledby="what-to-bring" class="mt-16">
      <SectionHeading id="what-to-bring">{sec(copy, 'whatToBring').heading}</SectionHeading>
      <div class="mt-6 max-w-3xl space-y-4 text-lg leading-relaxed text-body">
        <p>{sec(copy, 'whatToBring').body?.[0]}</p>
        <p class="text-base text-subtle">{sec(copy, 'whatToBring').note}</p>
      </div>
    </section>
  </div>
</BaseLayout>
