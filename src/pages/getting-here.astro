---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';

// Standalone, detailed Getting Here page. The shared <GettingHere /> component is the SUMMARY
// version embedded on product pages; this page expands on it with full travel detail.
const SITE = site.url;
const pageTitle = 'Getting Here | Millennium Footbridge, Salford Quays M50 3RB';
const pageDescription =
  'How to get to Manchester River Cruises. Board under the Millennium Footbridge, Salford Quays M50 3RB. Metrolink, parking, and taxi information.';

const boardingPhoto = '/images/gallery/our-boats/boats-moored-at-millennium-footbridge.webp';
const boardingPhotoCard = '/images/gallery/our-boats/boats-moored-at-millennium-footbridge-card.webp';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  name: 'Manchester River Cruises — Millennium Footbridge boarding point',
  description: pageDescription,
  url: `${SITE}/getting-here`,
  address: { '@type': 'PostalAddress', ...site.address },
  geo: { '@type': 'GeoCoordinates', ...site.geo },
};
---

<BaseLayout title={pageTitle} description={pageDescription} image={boardingPhoto}>
  {/* Schema.org structured data (Place + GeoCoordinates) */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20 lg:px-8">
    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Getting Here</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-body">
      All cruises depart from the Millennium Footbridge at Salford Quays (M50 3RB), beside
      MediaCityUK — a short walk from The Lowry and the Imperial War Museum North.
    </p>

    {/* Google Maps embed + owned boarding-point photo */}
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {/* Google Maps embed for the boarding point.
          - The keyless `?q=…&output=embed` form: no API key to leak, rotate or bill, and no
            Maps JS API quota. It renders the same interactive map.
          - loading="lazy" keeps the Maps payload off the critical path; the map is below the
            fold on every viewport.
          - referrerpolicy no-referrer-when-downgrade matches Google's own embed snippet.
          - title is required for a11y: an untitled iframe is an unlabelled landmark.
          ⚠ CSP — needs frame-src https://maps.google.com https://www.google.com. BOTH: the
            src is maps.google.com, which 301s to www.google.com/maps/embed (confirmed), and
            frame-src is enforced against the redirect target too. Nothing else is needed —
            our CSP does NOT govern subresources INSIDE a cross-origin iframe (the tiles,
            fonts and XHRs load under Google's own document and policy), so no img-src or
            connect-src entry is required. Neither origin is in the Report-Only policy yet;
            recorded in docs/launch-checklist.md so the enforce step includes them, otherwise
            enforcing CSP silently blanks this map. */}
      <iframe
        title="Map showing the Manchester River Cruises boarding point at the Millennium Footbridge, Salford Quays"
        src="https://maps.google.com/maps?q=Millennium%20Footbridge%2C%20The%20Quays%2C%20Salford%20M50%203RB&z=16&output=embed"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="aspect-video w-full rounded-card ring-1 ring-black/5"
        style="border:0"
      ></iframe>
      <img
        src={boardingPhoto}
        srcset={`${boardingPhotoCard} 800w, ${boardingPhoto} 1600w`}
        sizes="(min-width: 640px) 50vw, calc(100vw - 2rem)"
        alt="Manchester River Cruises boats moored at the Salford Quays boarding point beside the Millennium Footbridge and The Lowry"
        width="1600"
        height="1200"
        loading="lazy"
        decoding="async"
        data-img-fallback
        class="aspect-video w-full rounded-card object-cover ring-1 ring-black/5"
      />
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <section aria-labelledby="board">
        <SectionHeading id="board">Where to board</SectionHeading>
        <p class="mt-6 leading-relaxed text-body">
          {site.addressDisplay}. Look for the boarding point on
          the quayside beside the footbridge.
        </p>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Millennium+Footbridge+Salford+Quays+M50+3RB"
          class="mt-2 inline-block font-medium text-primary hover:underline"
          rel="noopener"
          target="_blank"
        >
          Open in Google Maps
        </a>
      </section>

      <section aria-labelledby="tram">
        <SectionHeading id="tram">By tram</SectionHeading>
        <p class="mt-6 leading-relaxed text-body">
          Take the Metrolink to <strong>MediaCityUK</strong> (on the Eccles/MediaCityUK line). From
          the stop it's a few minutes' walk across to the Millennium Footbridge. Nearby stops
          include Harbour City and Broadway. (Details TBC.)
        </p>
      </section>

      <section aria-labelledby="car">
        <SectionHeading id="car">By car &amp; parking</SectionHeading>
        <p class="mt-6 leading-relaxed text-body">
          Salford Quays is signposted from the M602 and M60. There are several pay-and-display and
          multi-storey car parks around the Quays and MediaCityUK, a short walk from the boarding
          point.
        </p>
        <ul class="mt-3 space-y-1 text-sm text-subtle">
          <li>Car park names &amp; distances — TBC</li>
          <li>Driving directions from the motorway — TBC</li>
        </ul>
      </section>

      <section aria-labelledby="taxi">
        <SectionHeading id="taxi">By taxi</SectionHeading>
        <p class="mt-6 leading-relaxed text-body">
          Taxis and ride-shares can drop off close to the Millennium Footbridge. Exact drop-off point
          TBC.
        </p>
      </section>

      <section aria-labelledby="bike">
        <SectionHeading id="bike">By bike</SectionHeading>
        <p class="mt-6 leading-relaxed text-body">
          Salford Quays is well connected by cycle routes along the waterfront. Cycle parking
          locations — TBC.
        </p>
      </section>
    </div>

    <div class="mt-16 rounded-card bg-panel p-6 ring-1 ring-black/5 sm:flex sm:items-center sm:justify-between sm:gap-6">
      <p class="font-semibold text-ink">Ready to get on the water?</p>
      <div class="mt-4 shrink-0 sm:mt-0">
        <CTAButton href="/tour/city-river-tours">Book a cruise</CTAButton>
      </div>
    </div>
  </div>
</BaseLayout>
