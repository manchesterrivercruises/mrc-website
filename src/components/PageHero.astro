---
import { existsSync } from 'node:fs';
import sharp from 'sharp';

// Shared dark-navy page hero (eyebrow, title, subtitle, optional CTA slot).
// The default slot renders below the subtitle — pass CTAButton(s) into it.
//
// Optional `heroImage`: when provided, the hero gets a background-image treatment — the image
// fills the section behind a navy gradient overlay (strong at the left/text side, lightening
// rightward) so the eyebrow/title/subtitle/CTAs stay unchanged and AA-legible over the overlaid
// (left/centre) region. Without a heroImage the hero is the plain navy block exactly as before.
// LCP: the image is eager + fetchpriority=high + preloaded, with real dimensions and no layout
// shift (it's absolutely positioned, object-cover). It ships a two-candidate srcset (≈800w card
// + large) at sizes="100vw" — the hero is full-bleed, so the viewport width IS the layout width
// — so phones fetch the card rather than the full-size hero. Pass preload={false} when the page
// emits its own head-slot preload.
//
// Optional `media` named slot: two-column layout on desktop (text left, media right) — the
// /gallery collage. Independent of heroImage (the gallery passes media, never heroImage).
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  heroImage?: string;
  heroImageAlt?: string;
  /** Small (≈800w) variant of heroImage, used as the mobile srcset candidate. Optional: when
      omitted the component looks for the conventional sibling itself, so existing callers get
      the responsive behaviour without a change. Pass explicitly to override. */
  heroImageCard?: string;
  /** Emit this component's own LCP preload. Set FALSE on a page that supplies its own
      head-slot preload (the homepage does, so it can tune imagesrcset/imagesizes) — otherwise
      the page ships two preloads for one image. */
  preload?: boolean;
}
const {
  eyebrow,
  title,
  subtitle,
  heroImage,
  heroImageAlt,
  heroImageCard,
  preload = true,
} = Astro.props;
const hasCta = Astro.slots.has('default');
const hasMedia = Astro.slots.has('media');

// Prefer a full-size variant over a `-card.webp` when one exists — either a sibling
// `-hero.webp` (the /images/events/ naming) or the album's plain `.webp` large (the
// /images/gallery/<album>/ naming, where the card is simply the 800px cut of the same frame).
// Events that only ship a card are used as-is; the heavy overlay masks the lower resolution.
function resolveHero(src: string): string {
  if (src.endsWith('-card.webp')) {
    const candidates = [src.replace(/-card\.webp$/, '-hero.webp'), src.replace(/-card\.webp$/, '.webp')];
    for (const full of candidates) {
      if (existsSync(`${process.cwd()}/public${full}`)) return full;
    }
  }
  return src;
}

// The ≈800w counterpart of a large hero, by the repo's two naming conventions:
//   /images/events/<name>-hero.webp   → <name>-card.webp
//   /images/gallery/<album>/<name>.webp → <name>-card.webp
// Returns null when no such file exists, in which case the <img> ships a single candidate.
function resolveCard(src: string): string | null {
  const guess = src.replace(/(-hero)?\.webp$/, '-card.webp');
  if (guess !== src && existsSync(`${process.cwd()}/public${guess}`)) return guess;
  return null;
}

async function dims(src: string): Promise<{ w: number; h: number }> {
  try {
    const m = await sharp(`${process.cwd()}/public${src}`).metadata();
    if (m.width && m.height) return { w: m.width, h: m.height };
  } catch {
    /* fall back to nominal dims — layout is unaffected (object-cover, absolute) */
  }
  return { w: 1600, h: 900 };
}

let hero: { src: string; alt: string; w: number; h: number; srcset?: string } | null = null;
if (heroImage) {
  const src = resolveHero(heroImage);
  const { w, h } = await dims(src);
  // Explicit card wins; otherwise look for the conventional sibling.
  const card = heroImageCard ?? resolveCard(src);
  let srcset: string | undefined;
  if (card) {
    const cw = (await dims(card)).w;
    // Only worth a second candidate if it is genuinely smaller than the large.
    if (cw < w) srcset = `${card} ${cw}w, ${src} ${w}w`;
  }
  hero = { src, alt: heroImageAlt ?? '', w, h, srcset };
}
---

<section class:list={['bg-dark text-white', hero && 'relative isolate overflow-hidden']}>
  {
    hero && (
      <Fragment>
        {/* LCP preload — skipped when the page supplies its own in the head slot, so exactly
            one preload is emitted. imagesrcset/imagesizes MUST mirror the <img> below or the
            preload is a separate resource and the image is fetched twice. */}
        {preload && (
          <link
            rel="preload"
            as="image"
            href={hero.src}
            imagesrcset={hero.srcset}
            imagesizes={hero.srcset ? '100vw' : undefined}
            fetchpriority="high"
          />
        )}
        <img
          src={hero.src}
          srcset={hero.srcset}
          sizes={hero.srcset ? '100vw' : undefined}
          alt={hero.alt}
          width={hero.w}
          height={hero.h}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover"
        />
        {/* Legibility overlay: strong navy at the left/text side, lightening rightward. */}
        <div
          class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-r from-dark via-dark/85 to-dark/40"
          aria-hidden="true"
        />
      </Fragment>
    )
  }
  <div
    class:list={[
      'mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24 lg:px-8',
      hasMedia && 'grid items-center gap-10 md:grid-cols-2 md:gap-12',
    ]}
  >
    <div>
      {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">{eyebrow}</p>}
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">{title}</h1>
      {subtitle && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/80">{subtitle}</p>}
      {hasCta && <div class="mt-8 flex flex-wrap items-center gap-4"><slot /></div>}
    </div>
    {hasMedia && <div class="min-w-0"><slot name="media" /></div>}
  </div>
</section>
